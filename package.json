{
  "name": "imageparser",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host localhost\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test",
    "preview": "vite preview",
    "start": "electron .",
    "serve": "node server.js",
    "prepare": "husky",
    "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\""
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "exiftool-vendored": "^38.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "wait-on": "^9.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts, tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{cls,cmp,component,css,html,json,md,page,trigger,xml,yaml,yml}": [
      "prettier --write"
    ]
  }
}
